[Unit]
Description=GuildLedger bot (merges #gl-ingest uploads, posts guild chat and roster logs)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=guildledger
Group=guildledger
WorkingDirectory=/var/lib/guildledger
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/guildledger/venv/bin/python -m guildledger_bot --config /etc/guildledger/config.toml run
Restart=always
RestartSec=10

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/guildledger
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target
